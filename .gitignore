# Secrets and credentials — never commit
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*credentials*
*secret*
*token*

# macOS
.DS_Store
._*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local Claude Code state
.claude/settings.local.json

# End-customer PII — never commit exports of restaurant contacts
# (aggregate metrics are OK; raw contact lists are not)
evidencias/**/contactos-*
evidencias/**/exports/raw-*
evidencias/**/*.csv

# Temporary and backup files
*.tmp
*.bak
*.log

# OS junk
Thumbs.db

# Graphify analysis cache — not part of the harness
graphify-out/
# Exportes locales con conversaciones de clientes; no versionar datos personales.
evidencias/*/conversaciones/raw/
# 185 MB de video descargado de Instagram de un cliente fuera del cupo; insumo reemplazable.
clientes/arepas-rellenas-samu/instagram/media/
# Carpeta de paso para material en transito.
tmp/
# Archivo vacio de trabajo.
untitled.md
